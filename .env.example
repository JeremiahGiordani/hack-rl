# Copy to .env (or export these directly) before running anything here.

# The API key itself. The variable NAME is configurable below via
# LLM_API_KEY_ENV — this default matches the OpenAI-compatible default.
OPENAI_API_KEY=sk-...

# Base URL of an OpenAI-compatible chat-completions API.
# Default if unset: https://api.openai.com/v1
# Point this at any compatible provider/gateway (Fireworks, Together,
# a self-hosted vLLM/OpenAI-shim endpoint, etc).
LLM_BASE_URL=https://api.openai.com/v1

# Model name/slug passed to both the plain HTTP client and the Codex CLI.
LLM_MODEL=gpt-5.1

# Name of the environment variable holding the API key for LLM_BASE_URL.
# Only change this if your provider's key lives under a different variable
# name than OPENAI_API_KEY (e.g. FIREWORKS_API_KEY).
LLM_API_KEY_ENV=OPENAI_API_KEY

# Optional: run Codex as a separate, less-privileged local user (mirrors the
# original pipeline's container setup, where generation ran as `runner`
# rather than root). Leave unset to run as the current user — the common
# case for a local checkout.
# CODEX_RUNNER_USER=runner
